# =============================================================
# n8n-g4f-router — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# Port the router will listen on (default: 3000)
ROUTER_PORT=3000

# Internal URL of the g4f service (used inside Docker network)
G4F_UPSTREAM_URL=http://g4f:8080

# Bearer token to protect your router endpoint (REQUIRED)
# Use a long, random string — e.g.: openssl rand -hex 32
ROUTER_API_KEY=change_me_to_a_secure_random_key

# How often (in milliseconds) the router health-checks all providers
# Default: 300000 (5 minutes). Minimum recommended: 60000 (1 minute)
HEALTH_CHECK_INTERVAL_MS=300000
